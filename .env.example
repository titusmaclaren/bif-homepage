# Black Iris Films website environment variables
# Copy this file to .env.local for local development.
# In Vercel, add the real production values under Project Settings > Environment Variables.
# Keep real values out of Git. Do not prefix private keys with NEXT_PUBLIC_.

# Public browser variables
# These are safe to expose publicly because analytics IDs are visible in browser tags.
# Add EITHER Google Tag Manager OR Google Analytics 4. If both are set, this site loads
# GTM only to avoid duplicate GA pageviews.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Transactional email via SMTP
# Required for contact form emails, contact acknowledgement emails, and estimate emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM="Black Iris Films <info@example.com>"
CONTACT_FORM_TO=info@example.com

# Beehiiv newsletter subscriptions
# Required when a visitor ticks a newsletter checkbox on a form.
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=pub_your-publication-id
BEEHIIV_SEND_WELCOME_EMAIL=true

# Video estimate generator
# Required for AI-powered estimates. Without this, the estimator returns a fallback range.
BIF_ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_API_KEY can be used instead on Vercel if preferred.
ANTHROPIC_API_KEY=
LEAD_WEBHOOK_URL=https://example.com/your-lead-webhook

# Google Business Profile reviews
GOOGLE_BUSINESS_ACCOUNT_ID=your-google-business-account-id
GOOGLE_BUSINESS_LOCATION_ID=your-google-business-location-id
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Social Media Theory of Everything report delivery
# Required for the report download form.
MAILERLITE_API_KEY=your-mailerlite-api-key
MAILERLITE_REPORT_GROUP_ID=your-mailerlite-report-group-id
# Legacy fallback name still supported by the code.
MAILERLITE_GROUP_ID=
